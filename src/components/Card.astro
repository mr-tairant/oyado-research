---
import Photo from './Photo.astro';
import {regionNames,typeNames} from '../lib/ja';
import {photo} from '../lib/photos';
import {regionSlug,type Property} from '../lib/data';
const {stay:p,index=0,ja=false}=Astro.props as {stay:Property,index?:number,ja?:boolean};
const prefix=ja?'/ja':'';
---
<article class="stay-card" data-name={p.name.toLowerCase()} data-region={p.region} data-type={p.type} data-tags={(p.tags.join(' ')+' '+(ja?p.intro:'')).toLowerCase()}>{photo(p.id)?<Photo id={p.id} variant="card" ja={ja} href={`${prefix}/stays/${p.id}/`}/>:<a href={`${prefix}/stays/${p.id}/`} class={`art art-${index%5}`} aria-label={`Read ${p.name}`}><span class="art-top">{p.region.toUpperCase()} / JAPAN</span><span class="art-kanji" aria-hidden="true">{['静','間','余','風','旅'][index%5]}</span><span class="art-bottom">{p.mode==='demo'?'FICTIONAL STAY':'STAY GUIDE'} · {String(index+1).padStart(2,'0')}<span>↗</span></span></a>}<div class="card-meta"><a href={`${prefix}/regions/${regionSlug(p.region)}/`}>{ja?regionNames[p.region]||p.region:p.region}</a><span>{ja?typeNames[p.type]||p.type:p.type}</span></div><h3><a href={`${prefix}/stays/${p.id}/`}>{p.name}</a></h3><p>{p.mode==='demo'?'A moment of stillness, an imagined journey.':p.intro}</p><div class="tags">{p.tags.map(t=><span>{t}</span>)}</div></article>
