---
import SamplePhotoCredit from './SamplePhotoCredit.astro';
import {Image} from 'astro:assets';
import {sampleImages} from '../lib/interview-sample-images';
import Layout from '../layouts/InterviewSample.astro';
import {sampleUi,samplesByLocale,sampleBase,type SampleLocale} from '../lib/interview-sample-i18n';
const {locale='ja',slug}=Astro.props as {locale:SampleLocale,slug?:string};
const t=sampleUi[locale],base=sampleBase(locale);
const samples=samplesByLocale[locale];
const item=samples.find(s=>s.slug===slug),images=item?sampleImages[item.slug as keyof typeof sampleImages]:undefined;
const others=samples.filter(s=>s.slug!==slug);
const heroAlt=(s:typeof samples[number])=>sampleImages[s.slug as keyof typeof sampleImages].portrait?`${s.person} — ${t.portraitAlt}`:t.buildingAlt;
const imageType=(s:typeof samples[number])=>t.imageTypes[s.slug==='townhouse-stay'?0:1];
---
<Layout locale={locale} title={item?item.title.replace('\n',' '):t.indexTitle.replace('\n',' ')} slug={slug}>
{item?<article class="interview">
 <div class="interview-heading"><a class="eyebrow" href={base}>INTERVIEW SAMPLE / {item.number}</a><p class="setting">{item.theme} · {item.property} ({t.fictional})</p><h1>{item.title}</h1><p class="subtitle">{item.subtitle}</p><p class="byline">{t.speaker}: {item.person} ({t.fictional})<br/>{t.unrecorded}</p></div>
 {images&&<figure class="sample-photo wide"><Image src={images.hero} alt={heroAlt(item)} widths={[480,900,1536]} sizes="86vw" loading="eager"/><figcaption>{images.credit?<SamplePhotoCredit locale={locale} credit={images.credit}/>:t.portraitCaption}</figcaption></figure>}
 <div class="interview-body"><aside><p class="eyebrow">IN CONVERSATION</p><p>{item.property}</p><p>{item.person} ({t.fictional})</p><p class="aside-note">{t.aside}</p></aside><div class="story"><p class="lead">{item.intro}</p>
 {item.sections.map((section,index)=><><section class="qa"><p class="chapter">0{index+1}</p><h2>{section.heading}</h2><h3><span>—</span> {section.question}</h3>{section.answer.map((text,i)=><p>{i===0&&<span class="speaker">{item.person}: </span>}{text}</p>)}</section>{index===1&&<blockquote><p>{item.quote}</p><cite>{item.person} ({t.fictionalQuote})</cite></blockquote>}{index===2&&images&&<figure class="sample-photo detail"><Image src={images.detail} alt={t.detailAlt} widths={[480,900,1536]} sizes="(max-width:800px) 86vw, 700px" loading="lazy"/><figcaption>{t.detailCaption}</figcaption></figure>}</>)}
 <section class="profile">{images?.portrait&&<figure class="profile-photo"><Image src={images.hero} alt={heroAlt(item)} widths={[240,480]} sizes="140px" loading="lazy"/><figcaption>{t.samplePerson}</figcaption></figure>}<p class="eyebrow">{t.profile}</p><h2>{item.person}</h2><p>{item.role}</p><p>{item.profile}</p></section>
 <div class="end-note"><strong>{t.endTitle}</strong><p>{t.endBody}</p></div>
 </div></div>
 <nav class="related-samples" aria-label={t.more}>{others.map(other=><a class="next-sample" href={`${base}${other.slug}/`}><span>{t.more} / {other.number}</span><h2>{other.title.replace('\n',' ')}</h2><span>{t.read} ↗</span></a>)}</nav>
 </article>:<>
 <section class="sample-intro"><p class="eyebrow">OYADO JOURNAL / INTERVIEW PRESENTATION</p><h1>{t.indexTitle}</h1><p class="deck">{t.deck}</p><p>{t.indexIntro}</p><p class="sample-label">{t.indexNote}</p></section>
 <section class="sample-grid" aria-label={t.list}>{samples.map(sample=><article class="sample-card"><a class="card-art" href={`${base}${sample.slug}/`}><Image src={sampleImages[sample.slug as keyof typeof sampleImages].hero} alt={heroAlt(sample)} widths={[480,900,1536]} sizes="(max-width:600px) 86vw, 43vw" loading="eager"/></a>{sampleImages[sample.slug as keyof typeof sampleImages].credit?<SamplePhotoCredit locale={locale} credit={sampleImages[sample.slug as keyof typeof sampleImages].credit!}/>:<p class="image-disclosure">{t.sampleImage} · {imageType(sample)}</p>}<p class="eyebrow">{sample.property} · {t.fictional}</p><h2><a href={`${base}${sample.slug}/`}>{sample.title}</a></h2><p>{sample.subtitle}</p><a class="text-link" href={`${base}${sample.slug}/`}>{t.read} ↗</a></article>)}</section>
 <section class="presentation-note"><p class="eyebrow">ABOUT THE INTERVIEW</p><h2>{t.aboutTitle}</h2><p>{t.about}</p><div class="steps">{t.steps.map((step,i)=><div><span>0{i+1}</span><h3>{step.title}</h3><p>{step.body}</p></div>)}</div><p class="fine">{t.fine}</p></section>
 </>}
</Layout>

<style>
.sample-intro h1,.sample-intro .deck,.presentation-note h2{white-space:pre-line}.related-samples{display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:stretch}.related-samples .next-sample{padding:35px 14%;width:100%}:global(html[lang=en]) .interview-heading h1{letter-spacing:0;line-height:1.25;overflow-wrap:anywhere}@media(max-width:600px){.related-samples{display:block}.related-samples .next-sample{padding:30px 7%}}
.profile{display:flow-root}.profile-photo{float:right;width:140px;margin:0 0 18px 24px}.profile-photo img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:center 20%}.profile-photo figcaption{font-size:10px;color:var(--muted);line-height:1.8;padding-top:7px}@media(max-width:600px){.profile-photo{width:105px;margin-left:16px}}
.sample-photo{margin:0}.sample-photo.wide{margin:0 7%}.sample-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.sample-photo.wide img{aspect-ratio:16/9;object-position:center 25%}.sample-photo figcaption{font-size:10px;color:var(--muted);line-height:1.9;padding-top:10px}.sample-photo.detail{margin-bottom:60px}.sample-card .card-art{padding:0;min-height:0;background:none}.card-art img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}.sample-card>.eyebrow{margin-top:22px}.sample-card .image-disclosure{font-size:10px;color:var(--muted);margin-top:-12px;margin-bottom:22px}
.sample-intro,.interview-heading{padding:70px 7% 45px;max-width:1300px;margin:auto}.sample-intro h1,.interview-heading h1{font-family:'Yu Mincho','Hiragino Mincho ProN',serif;line-height:1.65;font-size:clamp(38px,5vw,72px);letter-spacing:.04em;white-space:pre-line;margin:24px 0}.sample-intro>p:not(.eyebrow),.subtitle{font-size:15px;line-height:2.1;max-width:680px}.sample-intro .sample-label{font-size:12px;color:var(--muted);margin-top:30px}.setting{font-size:12px;margin-top:35px;color:var(--muted)}.byline{font-size:11px;line-height:1.9;margin-top:28px;color:var(--muted)}.sample-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px 7%;padding:10px 7% 80px}.sample-card:nth-child(2){margin-top:90px}.card-art{min-height:300px;background:#e6e5dc;display:flex;flex-direction:column;justify-content:space-between;padding:30px;margin-bottom:25px;color:#54594f}.sample-card:nth-child(2) .card-art{background:#e9e2d8;color:#64594c}.card-art span{font-size:10px;letter-spacing:.08em}.card-art .art-type{font-family:'Yu Mincho',serif;font-size:27px;line-height:1.7}.sample-card h2{font-family:'Yu Mincho',serif;font-size:32px;white-space:pre-line}.sample-card>p{font-size:13px;line-height:2}.sample-card:hover{text-decoration:none}.sample-card:hover h2{text-decoration:underline;text-underline-offset:8px}.photo-slot{margin:0}.photo-slot>div{background:#e6e5dc;min-height:390px;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:32px;text-align:center}.photo-slot span{font-size:10px;letter-spacing:.12em;color:#555c4d}.photo-slot>div p{font-family:'Yu Mincho',serif;font-size:22px;line-height:1.9;margin:20px 0}.photo-slot figcaption{font-size:10px;line-height:1.8;color:var(--muted);padding-top:10px}.wide{margin:0 7%}.interview-body{display:grid;grid-template-columns:180px minmax(0,700px);gap:70px;justify-content:center;margin:70px 7%}.interview-body aside{font-size:12px;line-height:1.9}.aside-note{color:var(--muted);font-size:11px}.lead{font-size:17px;line-height:2.2;margin-bottom:65px}.qa{margin:0 0 55px}.chapter{font:italic 15px Georgia,serif;color:var(--olive);border-top:1px solid var(--line);padding-top:22px}.qa h2{font-family:'Yu Mincho',serif;font-size:30px;line-height:1.8;margin:20px 0 28px}.qa h3{font-family:Arial,'Yu Gothic',sans-serif;font-size:14px;line-height:1.9;margin-bottom:25px}.qa>p:not(.chapter){font-size:15px;line-height:2.2;color:#4c4e47}.speaker{font-weight:bold;margin-right:8px;color:var(--ink)}blockquote{margin:65px 0;padding:25px 0 25px 30px;border-left:2px solid var(--olive)}blockquote p{font-family:'Yu Mincho',serif;font-size:clamp(25px,3vw,38px);line-height:1.9;white-space:pre-line}blockquote cite{font-style:normal;font-size:11px;color:var(--muted)}.detail{margin:0 0 60px}.detail>div{min-height:270px;background:#e9e2d8}.profile{padding:28px;border-block:1px solid var(--line);margin:55px 0 30px}.profile h2{font-size:24px}.profile>p:not(.eyebrow){font-size:12px;line-height:2}.end-note{font-size:11px;line-height:2;color:var(--muted)}.next-sample{display:block;padding:40px 7% 55px;border-top:1px solid var(--line)}.next-sample span{font-size:11px}.next-sample h2{font-family:'Yu Mincho',serif;font-size:30px;margin:20px 0}.presentation-note{background:#e9e7df;padding:55px 7%}.presentation-note h2{font-family:'Yu Mincho',serif;font-size:32px;line-height:1.8}.presentation-note>p{max-width:730px;font-size:13px;line-height:2}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:5%;margin:40px 0}.steps>div{border-top:1px solid #bcbdb2;padding-top:20px}.steps span{font:italic 16px Georgia,serif}.steps h3{font-size:19px;margin:20px 0 10px}.steps p{font-size:12px;line-height:1.9}.presentation-note .fine{font-size:11px;color:var(--muted)}
@media(max-width:800px){.interview-body{grid-template-columns:130px minmax(0,1fr);gap:30px}.sample-card h2{font-size:25px}.card-art{padding:20px;min-height:260px}.card-art .art-type{font-size:23px}}
@media(max-width:600px){.sample-intro,.interview-heading{padding:40px 7% 25px}.sample-intro h1{font-size:34px;letter-spacing:0}.interview-heading h1{font-size:30px;letter-spacing:0}.sample-grid{display:block;padding-bottom:45px}.sample-card{display:block;margin-bottom:40px}.sample-card:nth-child(2){margin-top:0}.card-art{min-height:260px}.sample-card h2{font-size:28px}.interview-body{display:block;margin-top:35px}.interview-body aside{border-bottom:1px solid var(--line);margin-bottom:30px;padding-bottom:15px}.lead{font-size:15px;margin-bottom:40px}.qa h2{font-size:26px}.qa>p:not(.chapter){font-size:14px}.photo-slot>div{min-height:260px;padding:25px}.photo-slot>div p{font-size:18px}.detail>div{min-height:220px}.steps{display:block}.steps>div{margin-top:25px}.presentation-note h2{font-size:26px}blockquote{padding-left:20px;margin:45px 0}.profile{padding:22px 0}}
@media print{.next-sample{display:none}.photo-slot>div{min-height:160px}.interview-body{display:block;margin-top:30px}.interview-body aside{display:none}.qa,.profile,blockquote{break-inside:avoid}.interview-heading{padding-top:20px}}
</style>
