---
import Layout from '../../layouts/Layout.astro';import {stays,article,demo,regionSlug} from '../../lib/data';
export function getStaticPaths(){return stays.map(p=>({params:{id:p.id},props:{p}}));}const {p}=Astro.props;const interview=article(p.id,'interviews');const schema=demo?null:{'@context':'https://schema.org','@type':'LodgingBusiness',name:p.name,url:new URL(`/stays/${p.id}/`,Astro.site).href};
---
<Layout title={`${p.name} — Stay Guide | OYADO`} description={p.intro} schema={schema}><section class="detail-head"><a class="eyebrow" href={`/regions/${regionSlug(p.region)}/`}>{p.region} / {p.type}</a><h1>{p.name}</h1><p class="deck">{p.intro}</p><div class="tags">{p.tags.map(t=><span>{t}</span>)}</div></section><div class="detail-art"><span>間</span><p>SPACE TO IMAGINE<br/>{demo?'FICTIONAL EDITORIAL SAMPLE':'OYADO JOURNAL'}</p></div><div class="article-layout"><aside><p class="eyebrow">IN THIS GUIDE</p><a href="#stay-guide">01 / Stay Guide</a>{interview&&<a href="#owner-interview">02 / Owner Interview</a>}<p>Last checked<br/><time datetime={p.updated_at}>{p.updated_at.slice(0,10)}</time></p><small>{demo?'Fictional sample · Draft':'Human-reviewed guide'}</small></aside><div><section id="stay-guide" class="prose"><p class="eyebrow">01 / STAY GUIDE</p><div set:html={article(p.id)}/></section>{interview&&<section id="owner-interview" class="prose"><p class="eyebrow">02 / OWNER INTERVIEW</p><div set:html={interview}/></section>}<section class="sources"><h2>Sources & editorial notes</h2>{demo?<p>This fictional sample contains no facts about a real property. Research candidates and unverified URLs are kept in internal data files, separate from this page.</p>:<ul>{p.facts.map(f=><li>{f.field}: {f.value} — <a href={f.source_url} rel="noopener noreferrer">{f.source_name}</a> (checked {f.retrieved_at.slice(0,10)})</li>)}</ul>}</section></div></div></Layout>
