---
import Layout from '../../layouts/Layout.astro';import Card from '../../components/Card.astro';import {stays,regions} from '../../lib/data';
---
<Layout title="The collection — OYADO"><section class="page-head"><p class="eyebrow">THE OYADO COLLECTION</p><h1>Find your <em>pause.</em></h1><p>Five fictional previews. A window into our future journal.</p></section><section class="collection"><form class="filters" role="search" onsubmit="return false"><label>Search stays<input id="query" type="search" placeholder="Name or feature…"/></label><label>Region<select id="region"><option value="">All regions</option>{regions.map(r=><option>{r}</option>)}</select></label><label>Stay style<select id="type"><option value="">All styles</option><option>Ryokan</option><option>Boutique hotel</option></select></label></form><p id="count" aria-live="polite">{stays.length} stays</p><div class="cards">{stays.map((p,i)=><Card stay={p} index={i}/>)}</div><p id="empty" hidden>No stays match. Try another name, region or feature.</p></section><script>const filter=()=>{const q=(document.querySelector('#query') as HTMLInputElement).value.toLowerCase();const r=(document.querySelector('#region') as HTMLSelectElement).value;const t=(document.querySelector('#type') as HTMLSelectElement).value;let n=0;document.querySelectorAll<HTMLElement>('.stay-card').forEach(c=>{c.hidden=!((''+c.dataset.name+' '+c.dataset.tags+' '+c.dataset.region).toLowerCase().includes(q)&&(!r||r===c.dataset.region)&&(!t||t===c.dataset.type));if(!c.hidden)n++;});document.querySelector('#count')!.textContent=`${n} stays`; (document.querySelector('#empty') as HTMLElement).hidden=n>0;};document.querySelectorAll('.filters input,.filters select').forEach(e=>e.addEventListener('input',filter));</script></Layout>
