---
import '../styles/global.css';
import '../styles/editorial.css';
import {copy,type Locale} from '../lib/international';
const {locale,title}=Astro.props as {locale:Locale,title:string};
const t=copy[locale],prefix='/'+locale;
const path=Astro.url.pathname.replace(/^\/(ko|zh-cn)(?=\/)/,'');
---
<!doctype html>
<html lang={t.lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} | OYADO JOURNAL</title><meta name="description" content={t.description}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><meta name="robots" content="noindex,nofollow"/><meta property="og:title" content={title}/><meta property="og:description" content={t.description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(Astro.url.pathname,Astro.site)}/><meta property="og:image" content={new URL('/og.png',Astro.site)}/><link rel="icon" href="/favicon.svg"/></head>
<body><a class="skip" href="#main">{t.skip}</a><div class="demo">{t.draft}</div><header><a class="wordmark" href={`${prefix}/`}>OYADO<span>JOURNAL — 日本の宿</span></a><nav aria-label={t.collection}><a href={`${prefix}/stays/`}>{t.collection}</a><a href={`${prefix}/regions/`}>{t.regions}</a><a href={`${prefix}/about/`}>{t.about}</a><a href={path} lang="en">EN</a><a href={'/ja'+path} lang="ja">日本語</a><a href={'/ko'+path} lang="ko" aria-current={locale==='ko'?'page':undefined}>한국어</a><a href={'/zh-cn'+path} lang="zh-Hans" aria-current={locale==='zh-cn'?'page':undefined}>简体中文</a></nav></header><main id="main"><slot/></main><footer><a class="wordmark" href={`${prefix}/`}>OYADO</a><p>{t.title}<br/>{t.description}</p><a href={`${prefix}/about/`}>{t.about} ↗</a><small>© {new Date().getFullYear()} OYADO JOURNAL · PRIVATE DRAFT REVIEW</small></footer></body></html>
<style>header{flex-wrap:wrap;gap:1.5rem}nav{flex-wrap:wrap}html:lang(ko){word-break:keep-all}html:lang(zh-Hans){line-break:strict}</style>
