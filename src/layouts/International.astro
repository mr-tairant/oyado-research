---
import '../styles/global.css';
import '../styles/editorial.css';
import {copy,type Locale} from '../lib/international';
import {internationalApproved} from '../lib/international-approval';
import {japaneseApproved} from '../lib/translations';
import {publicBuild} from '../lib/data';
const {locale,title}=Astro.props as {locale:Locale,title:string};
const t=copy[locale],prefix='/'+locale;
const path=Astro.url.pathname.replace(/^\/(ko|zh-cn)(?=\/)/,'');
const alternates=[{prefix:'',lang:'en',label:'EN'},...(!publicBuild||japaneseApproved?[{prefix:'/ja',lang:'ja',label:'日本語'}]:[]),...(['ko','zh-cn'] as const).filter(l=>!publicBuild||internationalApproved[l]).map(l=>({prefix:'/'+l,lang:copy[l].lang,label:copy[l].label}))];
---
<!doctype html>
<html lang={t.lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} | OYADO JOURNAL</title><meta name="description" content={t.description}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/>{!publicBuild&&<meta name="robots" content="noindex,nofollow"/>}<meta property="og:title" content={title}/><meta property="og:description" content={t.description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(Astro.url.pathname,Astro.site)}/><meta property="og:image" content={new URL('/og.png',Astro.site)}/>{alternates.map(a=><link rel="alternate" hreflang={a.lang} href={new URL(a.prefix+path,Astro.site)}/>)}<link rel="icon" href="/favicon.svg"/></head>
<body><a class="skip" href="#main">{t.skip}</a>{!internationalApproved[locale]&&<div class="demo">{t.draft}</div>}<header><a class="wordmark" href={`${prefix}/`}>OYADO<span>JOURNAL — 日本の宿</span></a><nav aria-label={t.collection}><a href={`${prefix}/stays/`}>{t.collection}</a><a href={`${prefix}/regions/`}>{t.regions}</a><a href={`${prefix}/about/`}>{t.about}</a>{alternates.map(a=><a href={a.prefix+path} lang={a.lang} aria-current={a.prefix===prefix?'page':undefined}>{a.label}</a>)}</nav></header><main id="main"><slot/></main><footer><a class="wordmark" href={`${prefix}/`}>OYADO</a><p>{t.title}<br/>{t.description}</p><a href={`${prefix}/about/`}>{t.about} ↗</a><small>© {new Date().getFullYear()} OYADO JOURNAL {!publicBuild?'· PRIVATE DRAFT REVIEW':''}</small></footer></body></html>
<style>header{flex-wrap:wrap;gap:1.5rem}nav{flex-wrap:wrap}html:lang(ko){word-break:keep-all}html:lang(zh-Hans){line-break:strict}</style>
