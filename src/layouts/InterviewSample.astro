---
import '../styles/global.css';
import {sampleUi,sampleLanguage,sampleLanguageNames,sampleLocales,sampleBase,type SampleLocale} from '../lib/interview-sample-i18n';
const {title,locale='ja',slug}=Astro.props as {title:string,locale?:SampleLocale,slug?:string};
const t=sampleUi[locale],base=sampleBase(locale),languages=sampleLocales;
---
<!doctype html>
<html lang={sampleLanguage[locale]}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} | OYADO JOURNAL</title><meta name="description" content={t.description}/><meta name="robots" content="noindex,nofollow"/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><meta property="og:image" content={new URL('/og.png',Astro.site)}/><link rel="icon" href="/favicon.svg"/></head>
<body><a class="skip" href="#main">{t.skip}</a><div class="sample-notice">{t.notice}</div><header><a class="wordmark" href={base}>OYADO<span>JOURNAL — INTERVIEW SAMPLE</span></a><nav aria-label={t.nav}><a href={base}>{t.list}</a><a href={locale==='en'?'/':'/'+locale+'/'}>{t.home} ↗</a><span class="sample-languages">{languages.map(l=><a href={sampleBase(l)+(slug?slug+'/':'')} lang={sampleLanguage[l]} aria-current={l===locale?'page':undefined}>{sampleLanguageNames[l]}</a>)}</span></nav></header><main id="main"><slot/></main><footer><a class="wordmark" href={base}>OYADO</a><p>{t.footer}<br/>{t.footerSub}</p><small>{t.footerFine}</small></footer></body></html>
<style>.sample-notice{padding:12px 5%;background:var(--ink);color:var(--paper);font-size:11px;line-height:1.8;text-align:center}header,nav{flex-wrap:wrap}.sample-languages{display:flex;flex-wrap:wrap;gap:16px}.sample-languages [aria-current=page]{text-decoration:underline;text-underline-offset:5px}html:lang(en) h1,html:lang(en) h2,html:lang(en) h3{font-family:Georgia,serif}html:lang(ko){word-break:keep-all}html{font-family:Arial,'Yu Gothic',sans-serif}h1,h2,h3{font-family:'Yu Mincho','Hiragino Mincho ProN',serif}@media print{header nav,.skip{display:none}.sample-notice{color:#242522;background:none;border-bottom:1px solid #aaa}footer{background:none;color:#242522}footer p,footer small{color:#242522}}</style>
