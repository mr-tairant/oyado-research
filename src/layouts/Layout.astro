---
import {demo,review,publicBuild} from '../lib/data';
import '../styles/global.css';
import '../styles/editorial.css';
const {title='OYADO — The quiet side of Japan',description='Thoughtful stays. Deeper journeys. An independent journal of places to stay in Japan.',schema}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/>
    <title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
    <meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/og.png',Astro.site)}/><meta name="twitter:card" content="summary_large_image"/>
    {!publicBuild&&<meta name="robots" content="noindex,nofollow"/>}
    {schema&&publicBuild&&<script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/>}
    <link rel="icon" href="/favicon.svg"/>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {demo&&<div class="demo">EDITORIAL PROTOTYPE · All five stays are fictional samples · Not a booking guide</div>}
    {review&&<div class="demo">PRIVATE EDITORIAL REVIEW · Real-property drafts awaiting human approval · Not for publication</div>}
    <header><a class="wordmark" href="/">OYADO<span>日本の宿</span></a><nav aria-label="Main navigation"><a href="/stays/">The collection</a><a href="/regions/">By region</a><a href="/about/">Our journal ↗</a></nav></header>
    <main id="main"><slot/></main>
    <footer><a class="wordmark" href="/">OYADO</a><p>A little closer to Japan.<br/>Independent stories of places to stay.</p><a href="/about/">Editorial & source policy ↗</a><small>© {new Date().getFullYear()} OYADO JOURNAL {demo?'· DEMONSTRATION':review?'· PRIVATE DRAFT REVIEW':''}</small></footer>
  </body>
</html>
