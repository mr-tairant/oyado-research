{
  "name": "oyado-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "discover": "node scripts/pipeline.mjs discover",
    "collect": "node scripts/pipeline.mjs collect",
    "generate": "node scripts/pipeline.mjs generate",
    "validate": "node scripts/pipeline.mjs validate",
    "test": "node --test scripts/pipeline.test.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/pipeline.mjs validate && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "astro": "^5.16.0",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0"
  }
}
