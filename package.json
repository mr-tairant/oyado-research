{
  "name": "oyado-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "discover": "node scripts/pipeline.mjs discover",
    "collect": "node scripts/pipeline.mjs collect",
    "generate": "node scripts/pipeline.mjs generate",
    "validate": "node scripts/pipeline.mjs validate && node scripts/check-photos.mjs",
    "test": "node --test scripts/pipeline.test.mjs scripts/international-review.test.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/pipeline.mjs validate && node scripts/check-photos.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro sync && tsc --noEmit",
    "dev:review": "node scripts/site.mjs dev --mode review --port 4322",
    "build:review": "node scripts/site.mjs build --mode review",
    "build:production": "node scripts/site.mjs build --mode production"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
